<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nulic</ToolCommandName>
    <!-- NuGet package metadata -->
    <PackageId>nulic</PackageId>
    <Authors>Tore Fuglestad</Authors>
    <Description>NuGet license disclosure tool — collects and produces a license package for all NuGet dependencies.</Description>
    <PackageTags>nuget license disclosure spdx</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/rafntor/nulic</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rafntor/nulic</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- MinVer: version derived from git tags (e.g. tag v1.0.0 => version 1.0.0) -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\README.md')" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\LICENSE')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="F23.StringSimilarity" />
    <PackageReference Include="Microsoft.Build" />
    <PackageReference Include="NuGet.Commands" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Textify" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>

</Project>